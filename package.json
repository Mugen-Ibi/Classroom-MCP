{
  "name": "classroom-mcp",
  "version": "1.0.0",
  "description": "Google ClassroomのMCPサーバー",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-oauth-provider.mjs",
    "check:oauth-patch": "node scripts/patch-oauth-provider.mjs",
    "dev": "wrangler dev",
    "deploy": "npm run check:config && wrangler deploy",
    "build": "npm run check:config && wrangler deploy --dry-run --outdir dist",
    "check:config": "npm run check:oauth-patch && node scripts/check-config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:config && wrangler deploy --dry-run --outdir dist && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:config && tsc --noEmit && wrangler deploy --dry-run --outdir dist && vitest run && prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mugen-Ibi/Classroom-MCP.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bugs": {
    "url": "https://github.com/Mugen-Ibi/Classroom-MCP/issues"
  },
  "homepage": "https://github.com/Mugen-Ibi/Classroom-MCP#readme",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.24.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@modelcontextprotocol/client": "2.0.0",
    "miniflare": "5.20260930.0-alpha",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.145.0"
  }
}
