{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classroom-mcp",
  "main": "src/index.ts",
  "minify": true,
  "assets": {
    "directory": "./public",
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  // Runtime variables are managed in Workers Settings, including PUBLIC_URL.
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "50886f599f7d48398a628e13f564600c",
    },
  ],
  // Preview authentication is isolated from the production OAuth namespace.
  // PUBLIC_URL and preview OAuth Secrets must be configured separately.
  "previews": {
    "kv_namespaces": [
      {
        "binding": "OAUTH_KV",
        "id": "f21f249707d94a7ca218df14ad8f6c3b",
      },
    ],
    "observability": { "enabled": false },
  },
  "observability": {
    "enabled": false,
  },
}
